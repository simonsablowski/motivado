    "n013": {
      "id": "n013",
      "type": "Text",
      "key": null,
      "title": "",
      "text": "Überlegen Sie, was Sie gar nicht erleben wollen, falls das eben nicht schon dabei war. Und dann die Frage, wie ist das in Ihrer aktuellen Beziehung?",
      "props": {
        "video": {
          "url": "REL_BezCheck_V14.flv"
        }
      },
      "next": [
        {
          "to": "n014"
        }
      ]
    },
    "n014": {
      "id": "n014",
      "type": "Text",
      "key": null,
      "title": "",
      "text": "Betrachten Sie jetzt wieder sich selbst: Inwieweit tragen Sie zu den Schwächen Ihrer Beziehung bei? Inwiefern tragen Sie zu den Stärken Ihrer Beziehung bei?",
      "props": {
        "video": {
          "url": "REL_BezCheck_V15.flv"
        }
      },
      "next": [
