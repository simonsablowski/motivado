# Base URL the videos, images and documents are served from (build time).
# Defaults to /media on the same origin.
VITE_MEDIA_BASE_URL=https://media.motivado.com

# Development only: local folder with the output of tools/build_media.py,
# served by the dev server under /media. Put this in .env.local.
# MEDIA_DIR=D:/path/to/media-out
