    "n008": {
      "id": "n008",
      "type": "ListView",
      "key": null,
      "title": "Was ist kein Mobbing?",
      "text": "Wichtig ist, dass nicht alle Angriffe auf Ihr Kind oder nicht alle Ärgernisse, die Ihr Kind durchlebt, ein Zeichen für Mobbing sind. Bitte denken Sie daher daran:",
      "props": {
        "elements": [
          {
            "element": "Normale Konflikte zwischen gleich starken Parteien sind kein Mobbing (Ein Mobbingopfer ist meist schwächer als der oder die Täter)",
            "second": 0
          },
          {
            "element": "Einmalige Belastungen und Konflikte sind noch kein Mobbing.",
            "second": 0
          },
          {
            "element": "Einmaliges Ausgrenzen oder Nichtinformieren ist noch kein Mobbing.",
            "second": 0
          },
          {
            "element": "Erst wenn die Angriffe über eine längere Zeit (!!) und wiederholt (!!) auftreten kann Mobbing im Spiel sein.",
            "second": 0
          },
          {
            "element": "Ein Mobbing entwickelt oft eine starke Dynamik in der immer mehr Täter über einen langen Zeitraum hinweg Angriffe gegen das Opfer vollführen.",
            "second": 0
          },
          {
            "element": "Ein abhanden gekommener Gegenstand (Turnbeutel o.ä.) kann auch verloren worden sein.",
            "second": 0
          },
          {
            "element": "Kopf- oder Bauschschmerzen können auch andere Ursachen haben.",
            "second": 0
          },
          {
            "element": "Schwache Schulleistungen können auch anderen Ursachen haben.",
            "second": 0
          }
        ]
      },
      "next": [
        {
          "to": "n009"
        }
      ]
    },
