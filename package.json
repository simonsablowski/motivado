{
  "name": "motivado",
  "private": true,
  "version": "0.1.0",
  "description": "Motivado – interactive video coaching",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "import": "npm run import -w @motivado/importer",
    "dev": "npm run dev -w @motivado/web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
